<section class="section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-section section-head__title reveal" data-delay="1">{{ section.settings.heading | default: 'Featured Drops' }}</h2>
        {%- if section.settings.lead != blank -%}<p class="section-head__lead reveal" data-delay="2">{{ section.settings.lead }}</p>{%- endif -%}
      </div>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="link-underline reveal" data-delay="2">View All &rarr;</a>
      {%- endif -%}
    </div>

    {%- liquid
      assign coll = section.settings.collection
      assign limit = section.settings.product_limit | default: 8
    -%}

    {%- if coll != blank and coll.products.size > 0 -%}
      <div class="product-grid" data-product-grid>
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, order: forloop.index %}
        {%- endfor -%}
      </div>
    {%- elsif collections.all.products.size > 0 -%}
      <div class="product-grid" data-product-grid>
        {%- for product in collections.all.products limit: limit -%}
          {% render 'product-card', product: product, order: forloop.index %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid">
        {%- for i in (1..4) -%}
          <article class="card reveal">
            <div class="card__media"><img src="{{ 'product-1' | placeholder_svg_tag }}" alt=""></div>
            <div class="card__body">
              <div class="card__cat">Sample Pack</div>
              <h3 class="card__title"><a href="{{ routes.all_products_collection_url }}">Example Drop {{ i }}</a></h3>
              <div class="card__price">$29.99</div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Catalog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Drops" },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "Studio-ready sounds engineered for the charts. Mixed, mastered, and royalty-cleared." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 12, "step": 4, "label": "Products to show", "default": 8 },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
