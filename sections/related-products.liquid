<section class="section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow reveal">{{ section.settings.eyebrow | default: 'Keep Digging' }}</p>
        <h2 class="h-section section-head__title reveal" data-delay="1">{{ section.settings.heading | default: 'You May Also Like' }}</h2>
      </div>
    </div>
    <div class="product-grid product-grid--4" data-product-grid>
      {%- assign limit = section.settings.product_limit | default: 4 -%}
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products limit: limit -%}
          {% render 'product-card', product: product, order: forloop.index %}
        {%- endfor -%}
      {%- else -%}
        {%- assign shown = 0 -%}
        {%- for p in collections.all.products -%}
          {%- if p.id != product.id and shown < limit -%}
            {% render 'product-card', product: p, order: forloop.index %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep Digging" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "product_limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
