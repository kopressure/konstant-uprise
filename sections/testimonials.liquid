<section class="section testimonials" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h-section section-head__title reveal" data-delay="1">{{ section.settings.heading | default: 'Trusted by hitmakers' }}</h2>
      {%- if section.settings.lead != blank -%}<p class="section-head__lead reveal" data-delay="2">{{ section.settings.lead }}</p>{%- endif -%}
    </div>

    <div class="testi-grid">
      {%- for block in section.blocks -%}
        <figure class="testi reveal" data-delay="{{ forloop.index0 | modulo: 3 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
            </div>
          {%- endif -%}
          <div class="testi__mark">&ldquo;</div>
          <blockquote class="testi__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testi__author">
            {%- if block.settings.avatar != blank -%}
              <img class="testi__avatar" src="{{ block.settings.avatar | image_url: width: 84 }}" alt="{{ block.settings.name | escape }}" width="42" height="42" loading="lazy">
            {%- else -%}
              <span class="testi__avatar"></span>
            {%- endif -%}
            <span>
              <span class="testi__name">{{ block.settings.name }}</span>
              {%- if block.settings.role != blank -%}<span class="testi__role" style="display:block">{{ block.settings.role }}</span>{%- endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Social Proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by hitmakers" },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "From bedroom producers to platinum placements — the pressure speaks for itself." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The drums hit different. First pack I bought landed me a placement two weeks later. KU is in every session now." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name", "default": "Marcus T." },
        { "type": "text", "id": "role", "label": "Role", "default": "Producer, ATL" },
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Star rating", "default": 5 }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "The drums hit different. First pack I bought landed me a placement two weeks later. KU is in every session now.", "name": "Marcus T.", "role": "Producer, ATL", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "Pressure Pass pays for itself. The monthly drops are consistently the best sounds in my library — mixed and ready.", "name": "Dani R.", "role": "Beatmaker, LA", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "Royalty-cleared and label-quality. I stopped digging for samples and started finishing songs. Worth every dollar.", "name": "Khalil A.", "role": "Recording Artist", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
