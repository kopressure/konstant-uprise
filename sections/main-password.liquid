<section class="hero hero__media--empty" data-section-id="{{ section.id }}">
  <div class="hero__media hero__media--empty"></div>
  <div class="container">
    <div class="hero__inner" style="max-width:640px">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Coming Soon' }}</p>
      <h1 class="display-1 hero__title">{{ section.settings.heading | default: 'Konstant Uprise' }}</h1>
      <p class="hero__sub">{{ section.settings.subheading | default: 'Built for pressure. Engineered for hitmakers. The store opens soon — drop your email to get in first.' }}</p>

      <div style="margin-top:36px;max-width:460px">
        {% render 'klaviyo-newsletter', list_id: section.settings.klaviyo_list_id, placeholder: 'Your email', button_label: 'Notify Me' %}
      </div>

      <div style="margin-top:40px">
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<div class="form-error" style="margin-bottom:14px">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="newsletter-form" style="max-width:460px;margin:0">
            <input type="password" name="password" placeholder="Enter store password" aria-label="Store password">
            <button type="submit" class="btn btn--ghost">Enter</button>
          </div>
        {%- endform -%}
      </div>

      <p class="form__note" style="margin-top:28px">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Coming Soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Konstant Uprise" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo List ID" }
  ]
}
{% endschema %}
