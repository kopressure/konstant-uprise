<section class="section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">Search</p>
      <h1 class="display-2 section-head__title">Find Your Sound</h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter-form" style="max-width:560px;margin:0 auto 48px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search packs, beats, bundles…" autocomplete="off">
      <button type="submit" class="btn btn--blue">Search</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <p class="section-head__lead text-center" style="margin-bottom:36px">{{ search.results_count }} results for &ldquo;{{ search.terms }}&rdquo;</p>
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, order: forloop.index %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="collection-empty"><p>No results for &ldquo;{{ search.terms }}&rdquo;. Try another search.</p></div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
