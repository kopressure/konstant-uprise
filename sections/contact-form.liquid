<section class="section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="commission">
      <div class="commission__intro reveal">
        <p class="eyebrow">{{ section.settings.eyebrow | default: 'Get In Touch' }}</p>
        <h1 class="display-2" style="margin-top:12px">{{ section.settings.heading | default: 'Contact' }}</h1>
        <div class="section-head__lead" style="margin-top:18px">{{ section.settings.body }}</div>
        {%- if section.settings.email != blank -%}
          <p style="margin-top:24px"><a class="link-underline" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        {%- endif -%}
      </div>

      <div class="commission__form reveal" data-delay="1">
        {%- form 'contact', class: 'form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-success">{% render 'icon', name: 'check' %} Thanks — message received. We’ll be in touch soon.</div>
          {%- elsif form.errors -%}
            <div class="form-error">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="form-row">
            <div class="field"><label for="c-name">Name</label><input type="text" id="c-name" name="contact[name]" required></div>
            <div class="field"><label for="c-email">Email</label><input type="email" id="c-email" name="contact[email]" required></div>
          </div>
          <div class="field"><label for="c-subject">Subject</label><input type="text" id="c-subject" name="contact[subject]"></div>
          <div class="field"><label for="c-body">Message</label><textarea id="c-body" name="contact[body]" required></textarea></div>
          <button type="submit" class="btn btn--blue btn--lg">Send Message</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get In Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Questions about a pack, your order, or the Pressure Pass? Drop us a line and we’ll get back to you within 48 hours.</p>" },
    { "type": "text", "id": "email", "label": "Public email" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
