<section class="section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Your Order</p>
        <h1 class="display-2 section-head__title">Cart</h1>
      </div>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-page">
          {%- for item in cart.items -%}
            <div class="cart-line" style="grid-template-columns:90px 1fr auto;padding:22px 0">
              <a class="cart-line__img" style="width:90px;height:90px" href="{{ item.url }}">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}">{%- endif -%}
              </a>
              <div>
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}<div class="cart-line__variant">{{ item.variant.title }}</div>{%- endunless -%}
                <div class="cart-line__bottom">
                  <div class="cart-line__qty">
                    <a href="{{ item.url_to_remove }}" aria-label="Decrease" onclick="event.preventDefault();fetch('{{ routes.cart_change_url }}',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:'{{ item.key }}',quantity:{{ item.quantity | minus: 1 }}})}).then(()=>location.reload())">&minus;</a>
                    <span>{{ item.quantity }}</span>
                    <a href="#" aria-label="Increase" onclick="event.preventDefault();fetch('{{ routes.cart_change_url }}',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:'{{ item.key }}',quantity:{{ item.quantity | plus: 1 }}})}).then(()=>location.reload())">+</a>
                  </div>
                  <a class="cart-line__remove" href="{{ item.url_to_remove }}">Remove</a>
                </div>
              </div>
              <div class="cart-line__price">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-drawer__foot" style="border:1px solid var(--color-line);border-radius:var(--radius);margin-top:32px;max-width:420px;margin-left:auto">
          <div class="cart-drawer__subtotal"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          <p class="cart-drawer__taxnote">Taxes &amp; discounts calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn--blue btn--lg btn--block">Checkout</button>
        </div>
      </form>
    {%- else -%}
      <div class="collection-empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--blue" style="margin-top:18px">Shop All Drops</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
