<section class="section" data-section-id="{{ section.id }}">
  <div class="container" style="max-width:880px">
    <div class="section-head section-head--center">
      <p class="eyebrow reveal">{{ section.settings.eyebrow | default: page.title }}</p>
      <h1 class="display-2 section-head__title reveal" data-delay="1">{{ page.title }}</h1>
    </div>
    <div class="product__desc rte reveal" data-delay="2" style="color:var(--color-text-dim);font-size:1.05rem">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" }
  ]
}
{% endschema %}
