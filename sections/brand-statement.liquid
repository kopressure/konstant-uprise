<section class="section brand-statement" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="brand-statement__inner">
      <div class="brand-statement__media reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}"
               srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w"
               sizes="(max-width: 990px) 90vw, 45vw"
               alt="{{ section.settings.image.alt | escape }}" width="900" height="1125" loading="lazy">
        {%- else -%}
          <img src="{{ 'lifestyle-1' | placeholder_svg_tag }}" alt="">
        {%- endif -%}
      </div>
      <div class="brand-statement__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-section brand-statement__title reveal" data-delay="1">{{ section.settings.heading | default: 'Engineered in the dark. Built for the spotlight.' }}</h2>
        <div class="brand-statement__body reveal" data-delay="2">{{ section.settings.body }}</div>

        {%- if section.blocks.size > 0 -%}
          <div class="stats reveal" data-delay="3">
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat' -%}
                <div class="stat" {{ block.shopify_attributes }}>
                  <div class="stat__num">{{ block.settings.number }}<span class="accent">{{ block.settings.suffix }}</span></div>
                  <div class="stat__label">{{ block.settings.label }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <div class="brand-statement__sig reveal" data-delay="3">
            {{ section.settings.signature }}
            {%- if section.settings.signature_role != blank -%}<small>{{ section.settings.signature_role }}</small>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand statement",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Brand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered in the dark. Built for the spotlight." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Konstant Uprise is the sound lab behind producer Kopressure — a premium independent music brand obsessed with one thing: pressure that translates to hits. Every pack is recorded, mixed, and mastered to industry standard, then royalty-cleared so you can release with zero hesitation.</p><p>No filler loops. No recycled kits. Just sounds engineered for producers who don’t settle.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "— KOPRESSURE" },
    { "type": "text", "id": "signature_role", "label": "Signature role", "default": "Founder & Lead Producer" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "10K" },
        { "type": "text", "id": "suffix", "label": "Accent suffix", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Producers served" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Brand statement",
      "blocks": [
        { "type": "stat", "settings": { "number": "10K", "suffix": "+", "label": "Producers served" } },
        { "type": "stat", "settings": { "number": "100", "suffix": "%", "label": "Royalty-free" } },
        { "type": "stat", "settings": { "number": "500", "suffix": "+", "label": "Sounds released" } }
      ]
    }
  ]
}
{% endschema %}
