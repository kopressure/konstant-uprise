<section class="logo-strip" data-section-id="{{ section.id }}" aria-label="As heard in">
  <div class="logo-strip__track">
    {%- for block in section.blocks -%}
      <span class="logo-strip__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- comment -%} duplicate for seamless marquee {%- endcomment -%}
    {%- for block in section.blocks -%}
      <span class="logo-strip__item" aria-hidden="true">{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Logo strip",
  "blocks": [
    { "type": "logo", "name": "Item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "PLATINUM PLACEMENTS" } ] }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Logo strip",
      "blocks": [
        { "type": "logo", "settings": { "text": "PLATINUM PLACEMENTS" } },
        { "type": "logo", "settings": { "text": "ROYALTY-FREE" } },
        { "type": "logo", "settings": { "text": "STUDIO MASTERED" } },
        { "type": "logo", "settings": { "text": "10,000+ PRODUCERS" } },
        { "type": "logo", "settings": { "text": "INSTANT DELIVERY" } },
        { "type": "logo", "settings": { "text": "BUILT FOR PRESSURE" } }
      ]
    }
  ]
}
{% endschema %}
