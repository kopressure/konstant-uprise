<section class="section section--tight" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow reveal">{{ section.settings.eyebrow | default: "In The Pack" }}</p>
      <h2 class="h-section section-head__title reveal" data-delay="1">{{ section.settings.heading | default: "What's Included" }}</h2>
    </div>
    <div class="included">
      {%- for block in section.blocks -%}
        <div class="included__item reveal" data-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product: What's included",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In The Pack" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Included" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "wave",
          "options": [
            { "value": "wave", "label": "Waveform" },
            { "value": "download", "label": "Download" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "lock", "label": "Lock" },
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Tag" },
            { "value": "infinity", "label": "Infinity" },
            { "value": "star", "label": "Star" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Studio-Ready WAVs" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "24-bit, mixed and mastered. Drag, drop, and build." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product: What's included",
      "blocks": [
        { "type": "feature", "settings": { "icon": "wave", "title": "Studio-Ready WAVs", "text": "24-bit, mixed and mastered. Drag, drop, and build." } },
        { "type": "feature", "settings": { "icon": "tag", "title": "100% Royalty-Free", "text": "Use in commercial releases with zero clearances." } },
        { "type": "feature", "settings": { "icon": "download", "title": "Instant Download", "text": "Delivered the second checkout completes." } },
        { "type": "feature", "settings": { "icon": "bolt", "title": "Hit-Tested Sounds", "text": "Engineered from the same kits behind real placements." } }
      ]
    }
  ]
}
{% endschema %}
