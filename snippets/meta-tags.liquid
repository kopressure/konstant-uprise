{%- comment -%} Open Graph + Twitter meta for premium link previews {%- endcomment -%}
{%- liquid
  if template.name == 'product'
    assign og_type = 'product'
  else
    assign og_type = 'website'
  endif

  assign og_title = page_title | default: shop.name
  assign og_desc = page_description | default: shop.description | default: shop.name

  if template.name == 'product' and product.featured_media
    assign og_image = product.featured_media | image_url: width: 1200
  elsif template.name == 'collection' and collection.featured_image
    assign og_image = collection.featured_image | image_url: width: 1200
  elsif settings.share_image
    assign og_image = settings.share_image | image_url: width: 1200
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image %}
<meta property="og:image" content="https:{{ og_image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https:{{ og_image }}">
{%- else %}
<meta name="twitter:card" content="summary">
{%- endif %}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">
{%- if template.name == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
